{
  "recomp": "PSPRecomp",
  "repo": "batatinhafcbatatinha-pixel/PSPRecomp",
  "branch": "main",
  "games_dir": "profiles",
  "setup": "tools/port-installer/setup/setup.ps1",
  "tools_dir": ".local/tools",
  "exe": "build/native/bin/CTWNative.exe",
  "ini": "build/native/bin/CTWNative.ini",
  "section": "opcoes",
  "vulkan_dir": null,
  "deps": {
    "buildtools_gb": 0,
    "python_gb": 0.1,
    "tools": [
      {
        "id": "llvm-mingw",
        "name": "llvm-mingw 20261020 (Clang 23)",
        "check": ".local/tools/llvm-mingw-20261020/bin/clang++.exe",
        "gb": 1.0
      },
      {
        "id": "cmake",
        "name": "CMake 3.31.12",
        "check": ".local/tools/cmake-3.31.12/bin/cmake.exe",
        "gb": 0.1
      },
      {
        "id": "ninja",
        "name": "Ninja 1.13.2",
        "check": ".local/tools/ninja-1.13.2/ninja.exe",
        "gb": 0.01
      }
    ]
  },
  "groups": [],
  "generic": {
    "play": "Play.cmd",
    "play_cmd": "@echo off\r\nrem Starts this game (built by the launcher with tools/pspport).\r\npython \"%~dp0..\\..\\..\\tools\\pspport\\pspport.py\" play --port \"%~dp0.\"\r\nexit /b %errorlevel%\r\n",
    "exe": "build/native/bin/PSPNative.exe",
    "disk_gb": 10,
    "download_gb": 1.2,
    "minutes": "60-180",
    "tools": [
      "llvm-mingw",
      "cmake",
      "ninja"
    ],
    "gb_per_job": 3,
    "steps": [
      {
        "name": "Decrypt and translate your game (PSPRecomp)",
        "run": [
          "{python}",
          "../../../tools/pspport/pspport.py",
          "prepare",
          "--port",
          "{root}"
        ],
        "done_if": "build/gen/generated_registry.cpp",
        "prepare": true
      },
      {
        "name": "Compile",
        "run": [
          "{python}",
          "../../../tools/pspport/pspport.py",
          "compile",
          "--port",
          "{root}",
          "--jobs",
          "{jobs}"
        ],
        "retry_if": "build/native/build.ninja"
      }
    ],
    "buildtools": false
  },
  "generic_label": "^[A-Z]{4}-\\d{5}$"
}

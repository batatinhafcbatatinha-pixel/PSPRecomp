{
  "recomp": "PSPRecomp",
  "repo": "batatinhafcbatatinha-pixel/PSPRecomp",
  "branch": "main",
  "games_dir": "profiles",
  "setup": "tools/port-installer/setup/setup.ps1",
  "tools_dir": ".local/tools",
  "exe": "build/native/bin/CTWNative.exe",
  "ini": "build/native/bin/CTWNative.ini",
  "section": "opcoes",
  "vulkan_dir": null,
  "deps": {
    "buildtools_gb": 0,
    "python_gb": 0.1,
    "tools": [
      {
        "id": "llvm-mingw",
        "name": "llvm-mingw 20261020 (Clang 23)",
        "check": ".local/tools/llvm-mingw-20261020/bin/clang++.exe",
        "gb": 1.0
      },
      {
        "id": "cmake",
        "name": "CMake 3.31.12",
        "check": ".local/tools/cmake-3.31.12/bin/cmake.exe",
        "gb": 0.1
      },
      {
        "id": "ninja",
        "name": "Ninja 1.13.2",
        "check": ".local/tools/ninja-1.13.2/ninja.exe",
        "gb": 0.01
      }
    ]
  },
  "groups": [],
  "generic": {
    "play": "Play.cmd",
    "play_cmd": "@echo off\r\nrem Starts this game (built by the launcher with tools/pspport).\r\npython \"%~dp0..\\..\\..\\tools\\pspport\\pspport.py\" play --port \"%~dp0.\"\r\nexit /b %errorlevel%\r\n",
    "exe": "build/native/bin/PSPNative.exe",
    "disk_gb": 10,
    "download_gb": 1.2,
    "minutes": "60-180",
    "tools": [
      "llvm-mingw",
      "cmake",
      "ninja"
    ],
    "gb_per_job": 3,
    "steps": [
      {
        "name": "Decrypt and translate your game (PSPRecomp)",
        "run": [
          "{python}",
          "../../../tools/pspport/pspport.py",
          "prepare",
          "--port",
          "{root}"
        ],
        "done_if": "build/gen/generated_registry.cpp",
        "prepare": true
      },
      {
        "name": "Compile",
        "run": [
          "{python}",
          "../../../tools/pspport/pspport.py",
          "compile",
          "--port",
          "{root}",
          "--jobs",
          "{jobs}"
        ],
        "retry_if": "build/native/build.ninja"
      }
    ],
    "buildtools": false,
    "settings": {
      "ini": "build/native/bin/PSPNative.ini",
      "section": "Display",
      "pc_menu": false,
      "groups": [
        {
          "pt": "Vídeo",
          "en": "Video",
          "items": [
            {
              "key": "InternalResolutionMode",
              "section": "Rendering",
              "pt": "Resolução interna",
              "en": "Internal resolution",
              "default": 0,
              "restart": true,
              "help_pt": "Abaixo da tela, o FSR amplia a imagem; a do PSP (480x272) é a mais leve.",
              "help_en": "Below the screen's, FSR enlarges the picture; the PSP's own (480x272) is the lightest.",
              "choices": [
                {
                  "v": 0,
                  "pt": "A da tela",
                  "en": "The screen's",
                  "word": "Desktop"
                },
                {
                  "v": 1,
                  "pt": "Multiplicar a do PSP",
                  "en": "A multiple of the PSP's",
                  "word": "Scale"
                },
                {
                  "v": 2,
                  "pt": "A do PSP (480x272)",
                  "en": "The PSP's (480x272)",
                  "word": "PSP"
                }
              ]
            },
            {
              "key": "InternalScale",
              "section": "Rendering",
              "pt": "Multiplicador da resolução",
              "en": "Resolution multiple",
              "default": 2,
              "min": 1,
              "max": 8,
              "restart": true,
              "help_pt": "Usado com \"Multiplicar a do PSP\": 2 = 960x544, 4 = 1920x1088, 8 = 3840x2176.",
              "help_en": "Used with \"A multiple of the PSP's\": 2 = 960x544, 4 = 1920x1088, 8 = 3840x2176."
            },
            {
              "key": "UpscaleFilter",
              "pt": "Ampliação da imagem",
              "en": "Picture scaling",
              "default": 1,
              "restart": true,
              "choices": [
                {
                  "v": 0,
                  "pt": "Pixels nítidos",
                  "en": "Sharp pixels",
                  "word": "Nearest"
                },
                {
                  "v": 1,
                  "pt": "Suave (bilinear)",
                  "en": "Smooth (bilinear)",
                  "word": "Bilinear"
                },
                {
                  "v": 2,
                  "pt": "AMD FSR 1.0",
                  "en": "AMD FSR 1.0",
                  "word": "FSR"
                },
                {
                  "v": 3,
                  "pt": "NVIDIA DLSS (placas RTX)",
                  "en": "NVIDIA DLSS (RTX cards)",
                  "word": "DLSS"
                }
              ],
              "help_pt": "DLSS precisa de placa NVIDIA RTX; sem ela, usa o FSR.",
              "help_en": "DLSS needs an NVIDIA RTX card; without one, FSR is used."
            },
            {
              "key": "DlssQuality",
              "pt": "Qualidade do DLSS",
              "en": "DLSS quality",
              "default": 2,
              "restart": true,
              "help_pt": "Usado com DLSS. DLAA não amplia: só suaviza bordas na resolução da tela.",
              "help_en": "Used with DLSS. DLAA does not enlarge: it only smooths edges at the screen's resolution.",
              "choices": [
                {
                  "v": 0,
                  "pt": "Desempenho",
                  "en": "Performance",
                  "word": "Performance"
                },
                {
                  "v": 1,
                  "pt": "Equilibrado",
                  "en": "Balanced",
                  "word": "Balanced"
                },
                {
                  "v": 2,
                  "pt": "Qualidade",
                  "en": "Quality",
                  "word": "Quality"
                },
                {
                  "v": 3,
                  "pt": "Ultra desempenho",
                  "en": "Ultra performance",
                  "word": "UltraPerformance"
                },
                {
                  "v": 5,
                  "pt": "DLAA",
                  "en": "DLAA",
                  "word": "DLAA"
                }
              ]
            },
            {
              "key": "Dlss5",
              "pt": "DLSS 5 (Neural Rendering)",
              "en": "DLSS 5 (Neural Rendering)",
              "default": 0,
              "restart": true,
              "help_pt": "Precisa do nvngx_dlssnr.dll que você mesmo colocar ao lado do jogo (a NVIDIA não publica; roda em RTX 50). Sem ele, nada muda.",
              "help_en": "Needs nvngx_dlssnr.dll that you put next to the game yourself (NVIDIA does not publish it; runs on RTX 50). Without it, nothing changes.",
              "choices": [
                {
                  "v": 0,
                  "pt": "Desligado",
                  "en": "Off",
                  "word": "false"
                },
                {
                  "v": 1,
                  "pt": "Ligado",
                  "en": "On",
                  "word": "true"
                }
              ]
            },
            {
              "key": "Dlss5Strength",
              "pt": "Força do DLSS 5",
              "en": "DLSS 5 strength",
              "default": 50,
              "min": 0,
              "max": 100,
              "step": 5,
              "restart": true
            },
            {
              "key": "Dlss5Style",
              "pt": "Estilo do DLSS 5",
              "en": "DLSS 5 style",
              "default": 0,
              "restart": true,
              "choices": [
                {
                  "v": 0,
                  "pt": "Padrão",
                  "en": "Default",
                  "word": "Default"
                },
                {
                  "v": 1,
                  "pt": "Natural",
                  "en": "Natural",
                  "word": "Natural"
                },
                {
                  "v": 2,
                  "pt": "Cinematográfico",
                  "en": "Cinematic",
                  "word": "Cinematic"
                }
              ]
            },
            {
              "key": "AspectRatio",
              "pt": "Proporção",
              "en": "Aspect",
              "default": 1,
              "restart": true,
              "help_pt": "Esticar preenche telas widescreen e ultrawide.",
              "help_en": "Stretching fills widescreen and ultrawide screens.",
              "choices": [
                {
                  "v": 0,
                  "pt": "Manter a do PSP",
                  "en": "Keep the PSP's",
                  "word": "Preserve"
                },
                {
                  "v": 1,
                  "pt": "Esticar na janela",
                  "en": "Stretch to the window",
                  "word": "Stretch"
                }
              ]
            },
            {
              "key": "Fullscreen",
              "pt": "Tela cheia",
              "en": "Fullscreen",
              "default": 1,
              "restart": true,
              "choices": [
                {
                  "v": 0,
                  "pt": "Desligado",
                  "en": "Off",
                  "word": "false"
                },
                {
                  "v": 1,
                  "pt": "Ligado",
                  "en": "On",
                  "word": "true"
                }
              ]
            },
            {
              "key": "ShowFPS",
              "pt": "Mostrar FPS",
